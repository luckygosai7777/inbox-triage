# Copy to backend/.env and fill in. Everything has a working default except the
# Google and Anthropic credentials.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Where the SPA runs. Used for CORS, CSRF and the OAuth return redirect.
FRONTEND_ORIGIN=http://localhost:5173

# --- Google OAuth -----------------------------------------------------------
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# GOOGLE_REDIRECT_URI below to its authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# gmail.modify is needed to archive; drop to gmail.readonly if you only sync.
# Changing this list requires the user to re-consent.
GOOGLE_OAUTH_SCOPES=openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar.readonly

GMAIL_SYNC_MAX_RESULTS=50

# --- Claude -----------------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to use an `ant auth login` profile instead.
# Set LLM_ENABLED=false to force the deterministic heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_ENABLED=true

# --- Triage tuning ----------------------------------------------------------
SCHEDULE_DAY_START=9
SCHEDULE_DAY_END=18
SCHEDULE_MIN_GAP_MINUTES=20
SCHEDULE_DEFAULT_BLOCK_MINUTES=30
DEFAULT_EFFORT_MINUTES=4

DORMANT_WINDOW_DAYS=90
DORMANT_OPEN_THRESHOLD=2
BLACKLIST_HOLD_DAYS=30

CAMPAIGN_BATCH_CAP=20
CAMPAIGN_COOLDOWN_HOURS=6

# Sending a mailto: unsubscribe needs real SMTP settings; off by default.
UNSUBSCRIBE_EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
