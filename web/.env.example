# Copy to .env.local for development. In production set these in
# Vercel -> Settings -> Environment Variables.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
# PUBLIC. Everything else stays server-side. Never add NEXT_PUBLIC_ to a secret.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses Row Level Security. Server-side only. If this leaks, every user's
# mail is readable - rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Encryption -------------------------------------------------------------
# Encrypts Google refresh tokens before they touch the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this means every user must reconnect Google. Changing it has the same
# effect, so treat it as permanent once you have real users.
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth -----------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI must be your Supabase callback:
#   https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Then paste the same client id/secret into
#   Supabase -> Authentication -> Providers -> Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Used where judgement matters: commitment extraction, VIP briefs.
ANTHROPIC_MODEL=claude-opus-5
# Used for inbox classification (high volume, low ambiguity). Leave blank to
# use ANTHROPIC_MODEL for everything. Setting a cheaper model here is the
# single biggest lever on cost per user - see README, Unit economics.
ANTHROPIC_MODEL_FAST=
# false forces the deterministic heuristics - useful for local work with no key
LLM_ENABLED=true

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000

# --- Tuning -----------------------------------------------------------------
GMAIL_SYNC_MAX_RESULTS=50
SCHEDULE_DAY_START=9
SCHEDULE_DAY_END=18
SCHEDULE_MIN_GAP_MINUTES=20
SCHEDULE_DEFAULT_BLOCK_MINUTES=30
DORMANT_WINDOW_DAYS=90
DORMANT_OPEN_THRESHOLD=2
CAMPAIGN_BATCH_CAP=20
CAMPAIGN_COOLDOWN_HOURS=6

# --- Background jobs --------------------------------------------------------
# Protects /api/cron/*. Vercel sends it as `Authorization: Bearer <value>`
# automatically once the variable exists on the project.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Digest email (optional) ------------------------------------------------
# Without these, digests are skipped rather than failing. Sign up at resend.com
# and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=Inbox Triage <digest@yourdomain.com>
